{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "noEmit": false,
    "incremental": false,
    "isolatedModules": true,
    "plugins": [],
    "types": ["node"]
  },
  "include": ["tests/**/*.test.ts"],
  "exclude": ["node_modules", ".next"]
}
